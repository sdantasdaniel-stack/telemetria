<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- registra o AuthFilter para interceptar todas as páginas protegidas -->
    <!-- qualquer requisição para /pages/* passa pelo AuthFilter antes de chegar ao FacesServlet -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.daniel.empresas.security.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/pages/*</url-pattern>
    </filter-mapping>
    
    <!-- mapeando /js/* para cá, as requisições para /sistema/js/sockjs.min.js vão direto para o Tomcat sem passar pelo Spring. -->
    <servlet-mapping>
    <servlet-name>default</servlet-name>
    <url-pattern>/js/*</url-pattern>
	</servlet-mapping>

    <!-- registra o FacesServlet — responsável por processar as páginas xhtml -->
    <!-- sem ele o Tomcat não sabe como processar arquivos .xhtml -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <!-- load-on-startup 1 garante que o FacesServlet é iniciado junto com a aplicação -->
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- mapeia o FacesServlet para processar todos os arquivos .xhtml -->
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- define a página de boas vindas — primeira página que o usuário vê -->
    <welcome-file-list>
        <welcome-file>login.xhtml</welcome-file>
    </welcome-file-list>

    <!-- define as páginas de erro padrão -->
    <!-- se ocorrer erro 404 redireciona para o login -->
    <error-page>
        <error-code>404</error-code>
        <location>/login.xhtml</location>
    </error-page>

    <!-- se ocorrer erro 403 redireciona para o login -->
    <error-page>
        <error-code>403</error-code>
        <location>/login.xhtml</location>
    </error-page>

</web-app>